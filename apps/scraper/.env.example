# BayStateScraper Configuration
# Copy this file to .env and fill in your values

# API Configuration
SCRAPER_API_URL=https://bay-state-app.vercel.app
SCRAPER_API_KEY=bsr_your_key_here
RUNNER_NAME=your-runner-name

# Browser Configuration
HEADLESS=true
POLL_INTERVAL=15

# =============================================================================
# AI Extraction Configuration
# =============================================================================
# The scraper uses Crawl4AI with an OpenAI-compatible API.
# All endpoints (OpenAI, DeepSeek, Local) are treated as OpenAI-compatible.

# --- Required ---
LLM_API_KEY=your_api_key_here

# --- Optional ---
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# --- Configuration Examples ---

# OpenAI (Default):
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# DeepSeek:
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1

# Local (LM Studio / Ollama):
# LLM_API_KEY=your-local-key  # Required
# LLM_MODEL=qwen2.5-7b-instruct
# LLM_BASE_URL=http://localhost:1234/v1

# Optional: Serper API for fallback product discovery
SERPER_API_KEY=your_serper_api_key_here

# =============================================================================
# Distributor Credentials (for live auth-gated extraction tests)
# =============================================================================
# These are ONLY needed for local testing against login-gated distributors.
# NEVER commit real credentials — use local env or coordinator credential API.

# Orgill (https://www.orgill.com)
# ORGILL_USERNAME=
# ORGILL_PASSWORD=

# Phillips Pet (https://shop.phillipspet.com)
# PHILLIPS_USERNAME=
# PHILLIPS_PASSWORD=

# Pet Food Experts (https://orders.petfoodexperts.com)
# PET_FOOD_EXPERTS_USERNAME=
# PET_FOOD_EXPERTS_PASSWORD=
