# =============================================================================
# BayState Scraper Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# This is the single source of truth for local development (bun run dev:up).

# API Configuration (localhost — Docker reaches host at host.docker.internal)
SCRAPER_API_URL=http://host.docker.internal:3000
SCRAPER_API_KEY=bsr_your_key_here
RUNNER_NAME=your-runner-name
ENVIRONMENT=dev

# Browser Configuration
HEADLESS=true
POLL_INTERVAL=15

# =============================================================================
# AI Extraction Configuration
# =============================================================================
# The scraper uses Crawl4AI with an OpenAI-compatible API.
# All endpoints (OpenAI, DeepSeek, Local) are treated as OpenAI-compatible.

# --- Required ---
LLM_API_KEY=your_api_key_here

# --- Optional ---
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# --- Configuration Examples ---

# OpenAI (Default):
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# DeepSeek:
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1

# Local (LM Studio / Ollama):
# LLM_API_KEY=not-needed
# LLM_MODEL=qwen2.5-7b-instruct
# LLM_BASE_URL=http://localhost:1234/v1

# Optional: Serper API for fallback product discovery
SERPER_API_KEY=your_serper_api_key_here

# =============================================================================
# AI Search Tuning
# =============================================================================
AI_SEARCH_ENABLE_TWO_STEP=false
AI_SEARCH_SECONDARY_THRESHOLD=0.75
AI_SEARCH_CIRCUIT_BREAKER_THRESHOLD=0.85
AI_SEARCH_CONFIDENCE_DELTA=0.1

# =============================================================================
# Local Supabase (for dev)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
AI_CREDENTIALS_ENCRYPTION_KEY="your_encryption_key_here"

# =============================================================================
# Packaging Vision Extraction (local VLM/OCR for product packaging text)
# =============================================================================
# Two-stage pipeline (recommended for Mac/Apple Silicon):
#   1. GLM-OCR extracts raw text from packaging images
#   2. Small text LLM converts raw text to structured packaging JSON
# Requires Ollama:
#   brew install ollama && ollama serve
#   ollama pull glm-ocr
#   ollama pull llama3.2:3b
PACKAGING_VISION_ENABLED=false
# Ollama OpenAI-compatible endpoint (default port 11434)
PACKAGING_VISION_BASE_URL=http://127.0.0.1:11434/v1
PACKAGING_VISION_MODEL=glm-ocr
PACKAGING_VISION_API_KEY=ollama
PACKAGING_VISION_TIMEOUT_SECONDS=180
PACKAGING_VISION_MAX_IMAGES=1
PACKAGING_VISION_MAX_CONCURRENCY=1
PACKAGING_VISION_ALLOW_EXTERNAL_FALLBACK=false
# Pipeline mode: ocr_then_parse (two-stage) or structured_vlm (single model)
PACKAGING_VISION_PIPELINE=ocr_then_parse
# Text parser model for converting raw OCR text to structured JSON
PACKAGING_TEXT_BASE_URL=http://127.0.0.1:11434/v1
PACKAGING_TEXT_MODEL=llama3.2:3b
PACKAGING_TEXT_API_KEY=ollama
PACKAGING_TEXT_TIMEOUT_SECONDS=120

# =============================================================================
# Distributor Credentials (for live auth-gated extraction tests)
# =============================================================================
# These are ONLY needed for local testing against login-gated distributors.
# NEVER commit real credentials — use local env or coordinator credential API.

# Orgill (https://www.orgill.com)
# ORGILL_USERNAME=
# ORGILL_PASSWORD=

# Phillips Pet (https://shop.phillipspet.com)
# PHILLIPS_USERNAME=
# PHILLIPS_PASSWORD=

# Pet Food Experts (https://orders.petfoodexperts.com)
# PET_FOOD_EXPERTS_USERNAME=
# PET_FOOD_EXPERTS_PASSWORD=
