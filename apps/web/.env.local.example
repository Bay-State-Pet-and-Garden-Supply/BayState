# =============================================================================
# Bay State App - Local Development Environment
# =============================================================================
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# NEVER paste production/Vercel secrets into your local .env.local.
#
# Required local tools:
#   - Supabase CLI  (for local database)
#   - Stripe CLI    (for local payment testing)
#   - Docker Desktop (required by Supabase CLI)
#
# ---------------------------------------------------------------------------     
# SUPABASE LOCAL
# ---------------------------------------------------------------------------     
# After running `supabase start`, the following keys are automatically synced
# by running: bun run web local:sync-env
#
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_placeholder_anon_key
SUPABASE_SECRET_KEY=sb_secret_placeholder_secret_key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# ---------------------------------------------------------------------------
# SITE URL (critical for auth redirects)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth Provider Identifiers (configured in Supabase Dashboard)
# Not required for local dev unless testing OAuth.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# STRIPE LOCAL / TEST MODE
# ---------------------------------------------------------------------------
# 1. Install Stripe CLI: https://stripe.com/docs/stripe-cli
# 2. Login:  stripe login
# 3. Listen: stripe listen --forward-to http://localhost:3000/api/payments/webhook
# 4. Copy the printed whsec_... value into STRIPE_WEBHOOK_SECRET below
# 5. Get test-mode publishable/secret keys from:
#    https://dashboard.stripe.com/test/apikeys
#
# Test card: 4242 4242 4242 4242  (any expiry/CVC/ZIP)
#
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_me_from_stripe_cli

# ---------------------------------------------------------------------------
# AI SCRAPER / ENRICHMENT (local placeholders)
# ---------------------------------------------------------------------------
# Generated with: openssl rand -base64 32
AI_CREDENTIALS_ENCRYPTION_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# ADMIN / E2E LOCAL CREDENTIALS
# ---------------------------------------------------------------------------
# Used by Playwright e2e tests and local admin seeding.
# Create a local admin in Supabase Studio (http://localhost:54323)
# or via the auth signup flow, then set these to match.
ADMIN_EMAIL=admin@baystate.local
ADMIN_PASSWORD=dev-password
E2E_ADMIN_EMAIL=admin@baystate.local
E2E_ADMIN_PASSWORD=dev-password
PLAYWRIGHT_ADMIN_EMAIL=admin@baystate.local
PLAYWRIGHT_ADMIN_PASSWORD=dev-password

# ---------------------------------------------------------------------------
# SCRAPER LOCAL PLACEHOLDERS
# ---------------------------------------------------------------------------
SCRAPER_API_KEY=bsr_local_dev_key
RUNNER_API_KEY=bsr_local_dev_key
INTERNAL_SCRAPER_API_KEY=bsr_local_dev_key

# ---------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# ---------------------------------------------------------------------------
# Resend (email)
RESEND_API_KEY=

# Mapbox (storefront map display)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Store coordinates (for delivery distance calculation)
STORE_LATITUDE=41.9000
STORE_LONGITUDE=-71.0900

# WebSocket / Realtime
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3000

# Stripe webhook for local development (listening on localhost)
# Set to the Stripe webhook signing secret from:
#   stripe listen --print-secret
# STRIPE_WEBHOOK_SECRET is used by apps/web/app/api/payments/webhook/route.ts

# ---------------------------------------------------------------------------
# DEPRECATED but kept for backwards compatibility
# ---------------------------------------------------------------------------
# ENABLE_SINGLE_PIPELINE_UI: No longer needed. The 5-tab pipeline UI is now
# the standard. This flag is ignored.
