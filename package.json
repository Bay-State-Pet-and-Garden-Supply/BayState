{
  "name": "baystate-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Bay State Pet and Garden Supply - Next.js web app and Python scraper",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*",
    "apps/mobile",
    "apps/web",
    "apps/scraper"
  ],
  "scripts": {
    "dev": "bunx turbo run dev",
    "build": "bunx turbo run build",
    "test": "bunx turbo run test",
    "lint": "bunx turbo run lint",
    "typecheck": "bunx turbo run typecheck",
    "web": "bun --cwd apps/web",
    "mobile": "bun --cwd apps/mobile",
    "scraper": "bun --cwd apps/scraper",
    "vercel-build": "cd apps/web && next build",
    "fallow": "fallow",
    "web:dev": "bun run web dev",
    "web:build": "bun run web build",
    "web:test": "bun run web test",
    "web:typecheck": "bun run web typecheck",
    "web:db:start": "bun run web db:start",
    "web:db:stop": "bun run web db:stop",
    "web:db:reset": "bun run web db:reset",
    "web:db:status": "bun run web db:status",
    "web:db:seed": "bun run web db:seed",
    "web:local:verify": "bun run web local:verify",
    "web:stripe:listen": "bun run web stripe:listen",
    "web:bootstrap": "bun run web bootstrap"
  },
  "devDependencies": {
    "fallow": "^2.54.3",
    "turbo": "^2.8.17"
  }
}
