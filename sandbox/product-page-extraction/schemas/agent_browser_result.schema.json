{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_browser_result.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "url", "success", "artifacts", "rendered"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "agent_browser_result.v1"},
    "run_id": {"type": "string"},
    "url": {"type": "string"},
    "success": {"type": "boolean"},
    "rendered": {
      "type": "object",
      "required": ["title", "h1", "images", "textSample", "imageCount", "productCardCount"],
      "properties": {
        "title": {"type": ["string", "null"]},
        "h1": {"type": "array", "items": {"type": "string"}},
        "images": {"type": "array", "items": {"type": "string"}},
        "textSample": {"type": "string"},
        "imageCount": {"type": "integer"},
        "productCardCount": {"type": "integer"},
        "extractionMethod": {"type": "string"},
        "productCards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {"type": "string"},
              "href": {"type": "string"},
              "image_urls": {"type": "array", "items": {"type": "string"}},
              "onclick": {"type": "string"},
              "element_signature": {"type": "string"}
            }
          }
        }
      }
    },
    "artifacts": {"type": "object"},
    "errors": {"type": "array"}
  }
}
