{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product_packet.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "input",
    "crawl",
    "extraction",
    "classification",
    "validation",
    "artifacts",
    "errors"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "product_extraction_packet.v1"
    },
    "run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "sandbox_version": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "discovery": {
      "type": "object"
    },
    "classification": {
      "type": "object",
      "required": [
        "page_type",
        "confidence",
        "product_card_count",
        "signals"
      ],
      "properties": {
        "page_type": {
          "enum": [
            "pdp",
            "collection",
            "category",
            "brand_home",
            "blog_support",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "product_card_count": {
          "type": "integer"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "crawl": {
      "type": "object",
      "required": [
        "success",
        "requested_url",
        "final_url"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "requested_url": {
          "type": "string"
        },
        "final_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "markdown_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "screenshot_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "html_length": {
          "type": "integer"
        },
        "markdown_length": {
          "type": "integer"
        },
        "jsonld_count": {
          "type": "integer"
        }
      }
    },
    "extraction": {
      "type": "object",
      "required": [
        "method",
        "llm_used",
        "confidence",
        "fields",
        "field_evidence",
        "media",
        "product_cards",
        "llm_metrics"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "llm_used": {
          "type": "boolean"
        },
        "llm_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "llm_skipped_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "llm_metrics": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "latency_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "attempts": {
              "type": [
                "integer",
                "null"
              ]
            },
            "timeout_count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "schema_validation_passed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fields": {
          "type": "object"
        },
        "field_evidence": {
          "type": "object"
        },
        "media": {
          "type": "object",
          "required": [
            "all_page_images",
            "candidate_product_images",
            "selected_product_images",
            "rejected_images",
            "default_images",
            "rendered_images",
            "llm_images",
            "selected_images",
            "image_count_by_method",
            "media_extraction_method"
          ],
          "properties": {
            "default_images": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rendered_images": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "llm_images": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "selected_images": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "image_count_by_method": {
              "type": "object",
              "required": [
                "default",
                "rendered",
                "llm",
                "all_page",
                "candidate_product",
                "selected_product",
                "rejected_noise"
              ],
              "additionalProperties": true
            },
            "media_extraction_method": {
              "type": "string"
            },
            "rendered_evidence_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "all_page_images": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "candidate_product_images": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "selected_product_images": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "llm_supported_images": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rejected_images": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "url",
                  "reason"
                ],
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "product_cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "image_urls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "onclick": {
                "type": "string"
              },
              "element_signature": {
                "type": "string"
              },
              "data_attributes": {
                "type": "object"
              },
              "nearby_text": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "matched_tokens": {
                "type": "array"
              },
              "missing_tokens": {
                "type": "array"
              }
            }
          }
        },
        "llm_raw": {}
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "recommendation"
      ],
      "properties": {
        "brand_match": {
          "type": "boolean"
        },
        "upc_match": {
          "type": "boolean"
        },
        "name_token_overlap": {
          "type": "number"
        },
        "required_fields_present": {
          "type": "boolean"
        },
        "recommendation": {
          "enum": [
            "accept",
            "review",
            "conflict"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_scores": {
          "type": [
            "object",
            "null"
          ]
        },
        "page_type_gating": {
          "type": "object"
        }
      }
    },
    "artifacts": {
      "type": "object"
    },
    "errors": {
      "type": "array"
    }
  }
}
